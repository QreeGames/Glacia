# Glacia Backend Environment Variables
PORT=3002
NODE_ENV=development

# Stellar Network & Soroban Configuration
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Glacia Soroban Contract ID (deploy via `stellar contract deploy`)
GLACIA_CONTRACT_ID=CCDANXNV2JNHTVJLTUMAPM77KQHNIYON7TKDXH3J7YYWLTH6NPRHSBK7

# Sponsored Relayer Secret Key (Sponsor network fees for gasless play)
# Generate via `stellar keys generate glacia-relayer --network testnet`
RELAYER_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RELAYER_PUBLIC_KEY=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Rate Limiting & Anti-Spam
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
